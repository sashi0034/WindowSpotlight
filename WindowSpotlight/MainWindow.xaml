<Window x:Class="WindowSpotlight.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        mc:Ignorable="d"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="WindowSpotlight"
        Width="960"
        Height="820"
        MinWidth="760"
        MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Loaded="OnLoaded"
        Closing="OnClosing"
        PreviewMouseLeftButtonUp="OnPreviewMouseLeftButtonUp"
        PreviewKeyDown="OnPreviewKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="28,24,28,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="WindowSpotlight" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Margin="0,5,0,0"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                           Text="外部アプリを中央に配置し、選んだディスプレイの余白を黒くします。" />
            </StackPanel>
            <TextBlock Grid.Column="1"
                       VerticalAlignment="Center"
                       FontFamily="Segoe MDL2 Assets"
                       FontSize="34"
                       Foreground="{DynamicResource SystemControlHighlightAccentBrush}"
                       Text="&#xE7B3;" />
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ConfigurationPanel" Margin="28,0,28,22">
                <Border x:Name="TargetSelectionCard" Margin="0,0,0,14" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="1  対象ウィンドウ" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock Margin="0,4,0,12"
                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                   Text="一覧から選ぶか、照準を画面上のウィンドウへドラッグしてください。" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="WindowComboBox"
                                      MinHeight="36"
                                      SelectionChanged="OnWindowSelectionChanged">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="24" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Image Width="20" Height="20" Source="{Binding Icon}" />
                                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                <TextBlock MaxWidth="620" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock FontSize="11"
                                                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                                           Text="{Binding ProcessName}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Grid.Column="1"
                                    Margin="8,0,0,0"
                                    Padding="14,6"
                                    Click="OnRefreshWindowsClick"
                                    Content="更新" />
                            <Button x:Name="PickerButton"
                                    Grid.Column="2"
                                    Margin="8,0,0,0"
                                    Padding="14,6"
                                    ToolTip="押したまま対象ウィンドウまでドラッグ"
                                    PreviewMouseLeftButtonDown="OnPickerMouseDown">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Margin="0,0,7,0" FontFamily="Segoe MDL2 Assets" Text="&#xE7C8;" />
                                    <TextBlock Text="照準で選択" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <TextBlock x:Name="WindowCapabilityText"
                                   Margin="0,9,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                    </StackPanel>
                </Border>

                <Border x:Name="MonitorSelectionCard" Margin="0,0,0,14" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="2  ディスプレイ" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock Margin="0,4,0,10"
                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                   Text="実際の配置を表した図から、黒背景を表示するディスプレイを選択します。" />
                        <Border Height="190"
                                CornerRadius="5"
                                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                BorderThickness="1"
                                Background="{DynamicResource SystemControlBackgroundAltMediumLowBrush}">
                            <Canvas x:Name="MonitorCanvas" SizeChanged="OnMonitorCanvasSizeChanged" />
                        </Border>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="3  表示設定" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <StackPanel Margin="0,12,0,0">
                            <RadioButton x:Name="UnchangedRadio"
                                         Margin="0,0,0,9"
                                         Content="現在のサイズを維持"
                                         GroupName="SizeMode"
                                         Checked="OnSizeModeChanged" />
                            <Grid Margin="0,0,0,9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="190" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="58" />
                                </Grid.ColumnDefinitions>
                                <RadioButton x:Name="PercentageRadio"
                                             VerticalAlignment="Center"
                                             Content="モニター比率に収める"
                                             GroupName="SizeMode"
                                             Checked="OnSizeModeChanged" />
                                <Slider x:Name="PercentageSlider"
                                        Grid.Column="1"
                                        Margin="12,0"
                                        Minimum="10"
                                        Maximum="100"
                                        SmallChange="5"
                                        LargeChange="10"
                                        TickFrequency="5"
                                        IsSnapToTickEnabled="True"
                                        ValueChanged="OnPercentageChanged" />
                                <TextBlock x:Name="PercentageText"
                                           Grid.Column="2"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Right" />
                            </Grid>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="190" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <RadioButton x:Name="ExactPixelsRadio"
                                             VerticalAlignment="Center"
                                             Content="ピクセルで指定"
                                             GroupName="SizeMode"
                                             Checked="OnSizeModeChanged" />
                                <TextBox x:Name="ExactWidthTextBox"
                                         Grid.Column="1"
                                         VerticalContentAlignment="Center"
                                         LostKeyboardFocus="OnExactSizeLostKeyboardFocus"
                                         KeyDown="OnExactSizeKeyDown" />
                                <TextBlock Grid.Column="2" Margin="8,0" VerticalAlignment="Center" Text="×" />
                                <TextBox x:Name="ExactHeightTextBox"
                                         Grid.Column="3"
                                         VerticalContentAlignment="Center"
                                         LostKeyboardFocus="OnExactSizeLostKeyboardFocus"
                                         KeyDown="OnExactSizeKeyDown" />
                                <TextBlock Grid.Column="4" Margin="8,0,0,0" VerticalAlignment="Center" Text="px" />
                            </Grid>
                            <ui:ToggleSwitch x:Name="RemoveTitleBarToggle"
                                             Header="可能なら標準タイトルバーを隠す" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2"
                Padding="28,14"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="0,1,0,0"
                Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border x:Name="StatusBadge"
                        Margin="0,0,16,0"
                        Padding="10,7"
                        CornerRadius="4"
                        HorizontalAlignment="Left">
                    <TextBlock x:Name="StatusText" Text="対象ウィンドウを選択してください。" TextWrapping="Wrap" />
                </Border>
                <Button x:Name="RecenterButton"
                        Grid.Column="1"
                        MinWidth="112"
                        Margin="0,0,8,0"
                        Click="OnRecenterClick"
                        Content="中央に再配置"
                        IsEnabled="False" />
                <Button x:Name="StopButton"
                        Grid.Column="2"
                        MinWidth="92"
                        Margin="0,0,8,0"
                        Click="OnStopClick"
                        Content="停止"
                        IsEnabled="False" />
                <Button x:Name="StartButton"
                        Grid.Column="3"
                        MinWidth="130"
                        Click="OnStartClick"
                        Content="スポットライト開始"
                        Style="{StaticResource AccentButtonStyle}" />
            </Grid>
        </Border>
    </Grid>
</Window>
